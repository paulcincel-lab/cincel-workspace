# ── Postgres (Drizzle) ───────────────────────────────────────────────────────
# Connection string for the Postgres database. Used by lib/db/client.ts,
# drizzle-kit (migrations/studio), and scripts/seed.ts. Server-side only.
# Local docker-compose default:
DATABASE_URL=postgres://cincel:cincel@localhost:5432/cincel
# When running the app container inside docker-compose, use the service name:
# DATABASE_URL=postgres://cincel:cincel@db:5432/cincel

# Password for the seeded bootstrap admin credential (scripts/seed.ts).
SEED_ADMIN_EMAIL=paul@cincel.mx
SEED_ADMIN_PASSWORD=CincelAdmin2026!

# ── Google Drive (Phase 4/6, optional) ───────────────────────────────────────
# Service-account access to Drive for the Recursos / project doc pickers, via
# domain-wide delegation impersonating the logged-in Cincel user (their
# institutional email) — so Google's own per-file permissions apply exactly as
# they already do. See docs/google-drive.md. Leave unset to disable the picker
# (manual URL entry still works).
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Company Shared Drive where project folders live (monday migration CLI,
# `npm run monday`; Staff SSO reuses it). The service account above must be a
# Content manager on it. See docs/google-drive.md.
GOOGLE_SHARED_DRIVE_ID=

# Real "Sign in with Google" — lets a user connect and switch between their
# own Google accounts (personal or work, any of them) through Google's real
# account chooser, instead of always using the impersonated institutional
# identity above. OAuth client from Google Cloud Console; the redirect URI
# to register there is <app origin>/api/google/oauth/callback. Leave unset
# to keep only the service-account picker. The same client powers the direct
# Google Calendar sync in Calendario (enable the Calendar API; see
# docs/google-drive.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Staff Google sign-in (Staff SSO, optional) ──────────────────────────────
# Login method flags, read server-side only (never NEXT_PUBLIC_*). Only
# "true"/"false" change them; anything else keeps the default.
# AUTH_GOOGLE_ENABLED (default false): shows "Entrar con Google" and enables
# /api/auth/google/*. AUTH_PASSWORD_ENABLED (default true): shows the
# email/password form and enables login, first access and change password.
# With the defaults, password login, the Drive picker and Calendar behave as
# before. Cutover steps in docs/google-drive.md.
AUTH_GOOGLE_ENABLED=false
AUTH_PASSWORD_ENABLED=true
# Public origin of the app (e.g. https://app.example.com). Builds the OAuth
# redirect URIs (<APP_ORIGIN>/api/auth/google/callback); never taken from the
# request. Sign-in reuses GOOGLE_OAUTH_CLIENT_ID/_SECRET above, as an Internal
# client of the company's Cloud project.
APP_ORIGIN=
# Workspace domain allowed to sign in (checked against the ID token's `hd`).
GOOGLE_WORKSPACE_DOMAIN=
# Optional Workspace customer id, for Directory groups.get.
GOOGLE_WORKSPACE_CUSTOMER_ID=
# AES-256 key for OAuth tokens at rest: 32 random bytes as 64 hex chars
# (e.g. `openssl rand -hex 32`). Never commit a real value.
TOKEN_ENCRYPTION_KEY=
# Hours between Workspace access re-checks of a signed-in staff member.
ACCESS_RECHECK_HOURS=4

# ── AI Assistant (Phase 5, optional) ────────────────────────────────────────
# OpenAI-compatible chat endpoint for /asistente. Point LLM_BASE_URL at any
# compatible /v1 surface (OpenAI, a local model, a Claude proxy, …). Leave
# unset to disable — the route returns 503 and the UI shows an error.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── GitHub RFCs (assistant `create_rfc` tool, optional) ─────────────────────
# Fine-grained personal access token scoped to Issues: write on GITHUB_REPO
# only (no other repo/org scope). Used to file RFCs the assistant drafts as
# GitHub Issues labeled "rfc". Leave unset to disable the tool — it tells the
# user GitHub isn't configured instead of failing silently.
GITHUB_PAT=
GITHUB_REPO=
