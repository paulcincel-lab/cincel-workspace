# ── Postgres (Drizzle) ───────────────────────────────────────────────────────
# Connection string for the Postgres database. Used by lib/db/client.ts,
# drizzle-kit (migrations/studio), and scripts/seed.ts. Server-side only.
# Local docker-compose default:
DATABASE_URL=postgres://cincel:cincel@localhost:5432/cincel
# When running the app container inside docker-compose, use the service name:
# DATABASE_URL=postgres://cincel:cincel@db:5432/cincel

# Password for the seeded bootstrap admin credential (scripts/seed.ts). There is
# no default: leave it empty and the seed generates a random one and prints it.
# E2E_ADMIN_PASSWORD (Playwright login) must match it. To pin one, set it here (e.g. a
# password manager value); never commit a placeholder like <choose-a-password>.
SEED_ADMIN_EMAIL=paul@cincel.mx
SEED_ADMIN_PASSWORD=
# E2E_ADMIN_PASSWORD=<same-as-SEED_ADMIN_PASSWORD>

# ── Google service account (optional) ───────────────────────────────────────
# The cincel-directory service account, acting as itself: it reads Workspace
# users and groups for staff sign-in (read-only admin role) and writes project
# folders as a Content manager of GOOGLE_SHARED_DRIVE_ID. The Drive picker uses
# each staff member's own token, not this account. See docs/google-drive.md.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Folder the picker starts in. Unset = the root of GOOGLE_SHARED_DRIVE_ID.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Company Shared Drive where project folders live (monday migration CLI,
# `npm run monday`, and project folders created by the app; Staff SSO reuses it). The service account above must be a
# Content manager on it. See docs/google-drive.md.
GOOGLE_SHARED_DRIVE_ID=

# Staff OAuth client (Internal) of the company's Google Cloud project: used by
# "Entrar con Google" and by the Drive (drive.readonly) and Calendar consent
# each staff member grants. Redirect URI: <APP_ORIGIN>/api/auth/google/callback.
# Enable the Drive and Calendar APIs; see docs/google-drive.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Staff Google sign-in (Staff SSO, optional) ──────────────────────────────
# Login method flags, read server-side only (never NEXT_PUBLIC_*). Only
# "true"/"false" change them; anything else keeps the default.
# AUTH_GOOGLE_ENABLED (default false): shows "Entrar con Google" and enables
# /api/auth/google/*. AUTH_PASSWORD_ENABLED (default true): shows the
# email/password form and enables login, first access and change password.
# With the defaults, password login, the Drive picker and Calendar behave as
# before. Cutover steps in docs/google-drive.md.
AUTH_GOOGLE_ENABLED=false
AUTH_PASSWORD_ENABLED=true
# Bootstrap admin (optional): set email and password together and the migrate
# job creates or updates that Administrador on every deploy. BOOTSTRAP_ADMIN_NAME
# (default "Administrador") is its display name; an existing row is renamed only
# while its name is still the email.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador
# Public origin of the app (e.g. https://app.example.com). Builds the OAuth
# redirect URIs (<APP_ORIGIN>/api/auth/google/callback); never taken from the
# request. Sign-in reuses GOOGLE_OAUTH_CLIENT_ID/_SECRET above, as an Internal
# client of the company's Cloud project.
APP_ORIGIN=
# Workspace domain allowed to sign in (checked against the ID token's `hd`).
GOOGLE_WORKSPACE_DOMAIN=
# Optional Workspace customer id, for Directory groups.get.
GOOGLE_WORKSPACE_CUSTOMER_ID=
# AES-256 key for OAuth tokens at rest: 32 random bytes as 64 hex chars
# (e.g. `openssl rand -hex 32`). Never commit a real value.
TOKEN_ENCRYPTION_KEY=
# Hours between Workspace access re-checks of a signed-in staff member.
ACCESS_RECHECK_HOURS=4

# ── Email (client portal invitations and sign-in links) ─────────────────────
# Outgoing mail over SMTP (lib/email). Production uses Gmail SMTP from one
# Workspace account: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the
# account (e.g. portal@cincel.mx), SMTP_PASSWORD=its app password (secret,
# never commit it), MAIL_FROM="Cincel <the same account>". Setup steps in
# docs/deployment.md. Leave SMTP_HOST empty to only log messages (dev).
# Local Mailpit (docker compose): SMTP_HOST=localhost, SMTP_PORT=1025, no
# user/password; read the mail at http://localhost:8025. The compose `app`
# service always points at Mailpit itself.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ── Background jobs (cron tick) ─────────────────────────────────────────────
# Bearer secret for POST /api/cron/tick, which the host cron calls every minute
# on the Docker network (see docs/deployment.md, "Cron tick"). Unset = the
# route answers 503 and no background job runs (notification email, daily
# digest). Generate one with `openssl rand -hex 32`; never commit a real value.
CRON_SECRET=

# ── Cutto deep links ────────────────────────────────────────────────────────
# Base URL for the "Abrir en Cutto" links (lib/integrations/cutto-links.ts).
# Public, inlined into the client bundle at build time. Default when unset:
# https://cutto.cloudketer.dev
NEXT_PUBLIC_CUTTO_BASE_URL=

# ── AI Assistant (Phase 5, optional) ────────────────────────────────────────
# OpenAI-compatible chat endpoint for /asistente. Point LLM_BASE_URL at any
# compatible /v1 surface (OpenAI, a local model, a Claude proxy, …). Leave
# unset to disable — the route returns 503 and the UI shows an error.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ── GitHub RFCs (assistant `create_rfc` tool, optional) ─────────────────────
# Fine-grained personal access token scoped to Issues: write on GITHUB_REPO
# only (no other repo/org scope). Used to file RFCs the assistant drafts as
# GitHub Issues labeled "rfc". Leave unset to disable the tool — it tells the
# user GitHub isn't configured instead of failing silently.
GITHUB_PAT=
GITHUB_REPO=

# ── monday import wizard (Configuración → Importar de monday) ──────────────────
# Folder for the wizard's monday exports (client data and files; keep it on a
# persistent volume). Empty = <app>/exports/wizard, fine for `npm run dev`.
# In the Docker image /app belongs to root, so set MONDAY_IMPORT_DIR=/data/monday
# and mount a volume there: the image creates that folder for the app user
# (KCD sets both from kcd.yml). A folder the app can't write shows "La carpeta
# de importación no tiene permisos de escritura." in the wizard.
MONDAY_IMPORT_DIR=
# Optional monday API token for the wizard's export. Empty = the admin types it
# in the wizard for each run; it is never stored or logged either way.
MONDAY_TOKEN=
# Local e2e only: 1 = the wizard talks to a fake monday API (the CLI fixture account).
MONDAY_FAKE=
