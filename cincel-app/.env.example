# Data source used by the app. "localstorage" (default) runs entirely on
# built-in mock data with no external dependencies. "supabase" reads/writes
# through the Supabase project configured below.
# NOTE: these NEXT_PUBLIC_* values are inlined into the build by Next.js, so
# for Docker they must be passed as build args (see docker-compose.yml),
# not just set here -- this file only covers `next dev`/`next start` locally.
NEXT_PUBLIC_CINCEL_DATA_SOURCE=localstorage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Postgres (Drizzle) ───────────────────────────────────────────────────────
# Connection string for the Postgres database. Used by lib/db/client.ts,
# drizzle-kit (migrations/studio), and scripts/seed.ts. Server-side only.
# Local docker-compose default:
DATABASE_URL=postgres://cincel:cincel@localhost:5432/cincel
# When running the app container inside docker-compose, use the service name:
# DATABASE_URL=postgres://cincel:cincel@db:5432/cincel

# Password for the seeded bootstrap admin credential (scripts/seed.ts).
SEED_ADMIN_EMAIL=paul@cincel.mx
SEED_ADMIN_PASSWORD=CincelAdmin2026!
